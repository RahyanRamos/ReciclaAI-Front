<%- include('layouts/partials/page-title', {
    title: titulo,
    subtitle: 'Visao geral do escopo academico',
    current: 'Sobre'
}) %>

<div class="row">
    <div class="col-xl-4 col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <span class="reciclaai-card-icon gradient-1 mr-3">
                        <i class="icon-globe"></i>
                    </span>
                    <div>
                        <h4 class="mb-0">ReciclaAI</h4>
                        <span class="text-muted">Programacao Web 2</span>
                    </div>
                </div>
                <p class="mb-0"><%= descricao %></p>
            </div>
        </div>
    </div>

    <div class="col-xl-8 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Escopo funcional</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <ul class="list-group">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Gestao de usuarios
                                <span class="badge badge-primary badge-pill">CRUD</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Materiais reciclaveis
                                <span class="badge badge-success badge-pill">Base</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Equipes de coleta
                                <span class="badge badge-info badge-pill">Logistica</span>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <ul class="list-group">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Solicitacoes
                                <span class="badge badge-warning badge-pill">Fluxo</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Coletas realizadas
                                <span class="badge badge-success badge-pill">Operacao</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Avaliacoes
                                <span class="badge badge-danger badge-pill">Feedback</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
