<%- include('../layouts/partials/page-title', {
    title: titulo,
    subtitle: 'Catalogo de materiais aceitos pela operacao',
    current: 'Materiais'
}) %>

<%- include('../layouts/partials/database-alerts') %>

<% const materiaisAtivos = materiais.filter((material) => material.ativo).length; %>

<div class="row">
    <%- include('../layouts/partials/metric-card', {
        label: 'Materiais',
        value: materiais.length,
        hint: 'Itens catalogados',
        progress: materiais.length ? 100 : 0,
        progressClass: 'bg-primary'
    }) %>
    <%- include('../layouts/partials/metric-card', {
        label: 'Ativos',
        value: materiaisAtivos,
        hint: 'Disponiveis para coleta',
        progress: materiais.length ? Math.round((materiaisAtivos / materiais.length) * 100) : 0,
        progressClass: 'bg-success'
    }) %>
    <%- include('../layouts/partials/metric-card', {
        label: 'Categorias',
        value: new Set(materiais.map((material) => material.categoria)).size,
        hint: 'Agrupamentos encontrados',
        progress: 75,
        progressClass: 'bg-warning'
    }) %>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title">Materiais reciclaveis</h4>
        <div class="reciclaai-page-actions">
            <a href="/materiais/criar" class="btn btn-primary">
                <i class="icon-plus mr-2"></i>Novo
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped reciclaai-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Categoria</th>
                        <th>Unidade</th>
                        <th>Ativo</th>
                        <th>Criado em</th>
                        <th>Acoes</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (materiais.length === 0) { %>
                        <%- include('../layouts/partials/empty-table-row', { colspan: 7 }) %>
                    <% } %>
                    <% for (let index = 0; index < materiais.length; index++) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><strong><%= materiais[index].nome %></strong></td>
                            <td><span class="badge badge-info"><%= materiais[index].categoria %></span></td>
                            <td><%= materiais[index].unidadeMedida %></td>
                            <td>
                                <% if (materiais[index].ativo) { %>
                                    <span class="badge badge-success reciclaai-status">Sim</span>
                                <% } else { %>
                                    <span class="badge badge-danger reciclaai-status">Nao</span>
                                <% } %>
                            </td>
                            <td><%= dateFormat(materiais[index].criadoEm) %></td>
                            <td>
                                <a href="/materiais/<%= materiais[index].id %>/editar" class="text-warning mr-2" title="Editar">
                                    <i class="fa fa-pencil fa-lg"></i>
                                </a>
                                <a href="/materiais/<%= materiais[index].id %>/excluir" class="text-danger mr-2" title="Excluir">
                                    <i class="fa fa-trash fa-lg"></i>
                                </a>
                                <a href="#" class="text-secondary remover" data-resource="materiais" data-label="material" data-name="<%= materiais[index].nome %>" data-id="<%= materiais[index].id %>" title="Excluir rapido">
                                    <i class="fa fa-times fa-lg"></i>
                                </a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
