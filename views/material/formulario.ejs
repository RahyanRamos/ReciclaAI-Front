<% const material = locals.material || {}; %>

<%- include('../layouts/partials/page-title', {
    title: titulo,
    subtitle: subtitulo,
    current: material.id ? 'Editar material' : 'Novo material'
}) %>

<div class="card">
    <div class="card-header">
        <h4 class="card-title"><%= material.id ? 'Editar material' : 'Cadastrar material' %></h4>
    </div>
    <div class="card-body">
        <form action="/materiais/<%= material.id ? material.id + '/editar' : 'criar' %>" method="POST">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="nome">Nome</label>
                    <input type="text" class="form-control" id="nome" name="nome" value="<%= material.nome || '' %>" required>
                </div>
                <div class="form-group col-md-6">
                    <label for="categoria">Categoria</label>
                    <input type="text" class="form-control" id="categoria" name="categoria" value="<%= material.categoria || '' %>" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="unidadeMedida">Unidade de medida</label>
                    <input type="text" class="form-control" id="unidadeMedida" name="unidadeMedida" value="<%= material.unidadeMedida || 'kg' %>" required>
                </div>
                <div class="form-group col-md-6">
                    <label for="ativo">Ativo</label>
                    <select class="form-control" id="ativo" name="ativo">
                        <option value="true" <%= material.ativo !== false ? 'selected' : '' %>>Sim</option>
                        <option value="false" <%= material.ativo === false ? 'selected' : '' %>>Nao</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mr-2">Salvar</button>
            <a href="/materiais" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
