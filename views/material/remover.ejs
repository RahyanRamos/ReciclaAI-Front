<%- include('../layouts/partials/page-title', {
    title: titulo,
    subtitle: subtitulo,
    current: 'Excluir material'
}) %>

<div class="row">
    <div class="col-lg-8 offset-lg-2">
        <div class="card border-danger">
            <div class="card-header bg-danger">
                <h4 class="card-title text-white mb-0">Confirmar exclusao</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">Esta acao excluira o registro de forma permanente.</div>
                <table class="table table-bordered">
                    <tbody>
                        <tr><th>Nome</th><td><%= material.nome %></td></tr>
                        <tr><th>Categoria</th><td><%= material.categoria %></td></tr>
                        <tr><th>Unidade</th><td><%= material.unidadeMedida %></td></tr>
                    </tbody>
                </table>
                <form action="/materiais/<%= material.id %>/excluir" method="POST">
                    <button type="submit" class="btn btn-danger mr-2">Confirmar exclusao</button>
                    <a href="/materiais" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
