<%- include('../layouts/partials/page-title', {
    title: titulo,
    subtitle: 'Times responsaveis pela logistica das coletas',
    current: 'Equipes'
}) %>

<%- include('../layouts/partials/database-alerts') %>

<% const equipesAtivas = equipes.filter((equipe) => equipe.ativo).length; %>

<div class="row">
    <%- include('../layouts/partials/metric-card', {
        label: 'Equipes',
        value: equipes.length,
        hint: 'Times cadastrados',
        progress: equipes.length ? 100 : 0,
        progressClass: 'bg-primary'
    }) %>
    <%- include('../layouts/partials/metric-card', {
        label: 'Ativas',
        value: equipesAtivas,
        hint: 'Disponiveis para atendimento',
        progress: equipes.length ? Math.round((equipesAtivas / equipes.length) * 100) : 0,
        progressClass: 'bg-success'
    }) %>
    <%- include('../layouts/partials/metric-card', {
        label: 'Empresas',
        value: new Set(equipes.map((equipe) => equipe.empresaResponsavel)).size,
        hint: 'Responsaveis vinculados',
        progress: 75,
        progressClass: 'bg-info'
    }) %>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title">Equipes de coleta</h4>
        <div class="reciclaai-page-actions">
            <a href="/equipes" class="btn btn-primary">
                <i class="icon-refresh mr-2"></i>Atualizar
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped reciclaai-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Empresa</th>
                        <th>Ativo</th>
                        <th>Criado em</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (equipes.length === 0) { %>
                        <%- include('../layouts/partials/empty-table-row', { colspan: 5 }) %>
                    <% } %>
                    <% for (let index = 0; index < equipes.length; index++) { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><strong><%= equipes[index].nome %></strong></td>
                            <td><%= equipes[index].empresaResponsavel %></td>
                            <td>
                                <% if (equipes[index].ativo) { %>
                                    <span class="badge badge-success reciclaai-status">Sim</span>
                                <% } else { %>
                                    <span class="badge badge-danger reciclaai-status">Nao</span>
                                <% } %>
                            </td>
                            <td><%= dateFormat(equipes[index].criadoEm) %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
