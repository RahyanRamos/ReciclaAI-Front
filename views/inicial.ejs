<%- include('layouts/partials/page-title', {
    title: titulo,
    subtitle: subtitulo,
    current: 'Painel'
}) %>

<div class="row">
    <%- include('layouts/partials/metric-card', {
        label: 'Modulos ativos',
        value: resumoRotas.length,
        hint: 'Areas administrativas conectadas ao menu',
        progress: 100,
        progressClass: 'bg-success'
    }) %>

    <%- include('layouts/partials/metric-card', {
        label: 'Cadastros',
        value: 3,
        hint: 'Usuarios, materiais e equipes',
        progress: 50,
        progressClass: 'bg-primary'
    }) %>

    <%- include('layouts/partials/metric-card', {
        label: 'Operacao',
        value: 3,
        hint: 'Solicitacoes, coletas e avaliacoes',
        progress: 50,
        progressClass: 'bg-warning'
    }) %>

    <%- include('layouts/partials/metric-card', {
        label: 'Atualizado em',
        value: horaAgora,
        hint: 'Horario local do servidor',
        progress: 100,
        progressClass: 'bg-info'
    }) %>
</div>

<div class="row">
    <div class="col-xl-8 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Rotas de administracao</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped reciclaai-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Modulo</th>
                                <th>Descricao</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let index = 0; index < resumoRotas.length; index++) { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <a href="<%= resumoRotas[index].rota %>">
                                            <%= resumoRotas[index].rota %>
                                        </a>
                                    </td>
                                    <td><%= resumoRotas[index].descricao %></td>
                                    <td>
                                        <span class="badge badge-success reciclaai-status">Ativo</span>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <span class="reciclaai-card-icon gradient-4 mr-3">
                        <i class="icon-speedometer"></i>
                    </span>
                    <div>
                        <h4 class="mb-0">Status da API</h4>
                        <span class="text-muted">Monitoramento rapido</span>
                    </div>
                </div>
                <p class="mb-3">Endpoint publico para validar a aplicacao NestJS.</p>
                <a href="/status" class="btn btn-primary btn-block">
                    <i class="icon-link mr-2"></i> Abrir /status
                </a>
            </div>
        </div>
    </div>
</div>
