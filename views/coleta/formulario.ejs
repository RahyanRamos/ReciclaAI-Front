<% const coleta = locals.coleta || {}; %>
<% const materiaisColeta = coleta.materiais || []; %>

<%- include('../layouts/partials/page-title', {
    title: titulo,
    subtitle: subtitulo,
    current: 'Editar coleta'
}) %>

<div class="card">
    <div class="card-header">
        <h4 class="card-title">Editar coleta</h4>
    </div>
    <div class="card-body">
        <% if (coleta.solicitacao) { %>
            <div class="alert alert-info">Coleta gerada a partir da solicitacao: <strong><%= coleta.solicitacao.descricao %></strong></div>
        <% } %>
        <form action="/coletas/<%= coleta.id %>/editar" method="POST">
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label for="dataColeta">Data</label>
                    <input type="date" class="form-control" id="dataColeta" name="dataColeta" value="<%= coleta.dataColeta || '' %>" required>
                </div>
                <div class="form-group col-md-4">
                    <label for="status">Status</label>
                    <select class="form-control" id="status" name="status">
                        <% for (let index = 0; index < statusColeta.length; index++) { %>
                            <option value="<%= statusColeta[index] %>" <%= coleta.status === statusColeta[index] ? 'selected' : '' %>><%= statusColeta[index] %></option>
                        <% } %>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label for="observacao">Observacao</label>
                <textarea class="form-control" id="observacao" name="observacao" rows="4"><%= coleta.observacao || '' %></textarea>
            </div>

            <hr>

            <h5>Materiais</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Material</th>
                        <th>Unidade</th>
                        <th>Quantidade estimada</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let index = 0; index < materiaisColeta.length; index++) { %>
                        <% const item = materiaisColeta[index]; %>
                        <tr>
                            <td><%= item.material.nome %></td>
                            <td><%= item.material.unidadeMedida %></td>
                            <td>
                                <input type="hidden" name="coletaMaterialId[]" value="<%= item.id %>">
                                <input type="number" step="0.01" min="0" class="form-control" name="quantidadeEstimada[]" value="<%= item.quantidadeEstimada %>" required>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <button type="submit" class="btn btn-primary mr-2">Salvar</button>
            <a href="/coletas" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
