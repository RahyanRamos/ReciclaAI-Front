<%- include('../layouts/partials/page-title', {
    title: titulo,
    subtitle: 'Pedidos de retirada enviados pelos clientes',
    current: 'Solicitacoes'
}) %>

<%- include('../layouts/partials/database-alerts') %>

<% const solicitacoesAbertas = solicitacoes.filter((solicitacao) => solicitacao.status === 'ABERTA').length; %>
<% const solicitacoesConcluidas = solicitacoes.filter((solicitacao) => solicitacao.status === 'CONCLUIDA').length; %>

<div class="row">
    <%- include('../layouts/partials/metric-card', {
        label: 'Solicitacoes',
        value: solicitacoes.length,
        hint: 'Pedidos registrados',
        progress: solicitacoes.length ? 100 : 0,
        progressClass: 'bg-primary'
    }) %>
    <%- include('../layouts/partials/metric-card', {
        label: 'Abertas',
        value: solicitacoesAbertas,
        hint: 'Aguardando atendimento',
        progress: solicitacoes.length ? Math.round((solicitacoesAbertas / solicitacoes.length) * 100) : 0,
        progressClass: 'bg-warning'
    }) %>
    <%- include('../layouts/partials/metric-card', {
        label: 'Concluidas',
        value: solicitacoesConcluidas,
        hint: 'Fluxos finalizados',
        progress: solicitacoes.length ? Math.round((solicitacoesConcluidas / solicitacoes.length) * 100) : 0,
        progressClass: 'bg-success'
    }) %>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="card-title">Solicitacoes de coleta</h4>
        <div class="reciclaai-page-actions">
            <a href="/solicitacoes/criar" class="btn btn-primary">
                <i class="icon-plus mr-2"></i>Nova
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped reciclaai-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Descricao</th>
                        <th>Localizacao</th>
                        <th>Volume estimado</th>
                        <th>Status</th>
                        <th>Acoes</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (solicitacoes.length === 0) { %>
                        <%- include('../layouts/partials/empty-table-row', { colspan: 6 }) %>
                    <% } %>
                    <% for (let index = 0; index < solicitacoes.length; index++) { %>
                        <% const status = solicitacoes[index].status; %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><strong><%= solicitacoes[index].descricao %></strong></td>
                            <td><%= solicitacoes[index].localizacao %></td>
                            <td><%= solicitacoes[index].volumeEstimadoTotal.toFixed(2) %></td>
                            <td>
                                <% if (status === 'CONCLUIDA') { %>
                                    <span class="badge badge-success reciclaai-status"><%= status %></span>
                                <% } else if (status === 'CANCELADA') { %>
                                    <span class="badge badge-danger reciclaai-status"><%= status %></span>
                                <% } else if (status === 'AGENDADA') { %>
                                    <span class="badge badge-info reciclaai-status"><%= status %></span>
                                <% } else { %>
                                    <span class="badge badge-warning reciclaai-status"><%= status %></span>
                                <% } %>
                            </td>
                            <td>
                                <% if (status === 'ABERTA') { %>
                                    <a href="/solicitacoes/<%= solicitacoes[index].id %>/aceitar" class="text-success mr-2" title="Aceitar">
                                        <i class="fa fa-check fa-lg"></i>
                                    </a>
                                <% } %>
                                <a href="/solicitacoes/<%= solicitacoes[index].id %>/editar" class="text-warning mr-2" title="Editar">
                                    <i class="fa fa-pencil fa-lg"></i>
                                </a>
                                <a href="/solicitacoes/<%= solicitacoes[index].id %>/excluir" class="text-danger mr-2" title="Excluir">
                                    <i class="fa fa-trash fa-lg"></i>
                                </a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
