<% const usuario = locals.usuario || {}; %>

<%- include('../layouts/partials/page-title', {
    title: titulo,
    subtitle: subtitulo,
    current: usuario.id ? 'Editar usuario' : 'Novo usuario'
}) %>

<div class="card">
    <div class="card-header">
        <h4 class="card-title"><%= usuario.id ? 'Editar usuario' : 'Cadastrar usuario' %></h4>
    </div>
    <div class="card-body">
        <form action="/usuarios/<%= usuario.id ? usuario.id + '/editar' : 'criar' %>" method="POST">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="nome">Nome</label>
                    <input type="text" class="form-control" id="nome" name="nome" value="<%= usuario.nome || '' %>" required>
                </div>
                <div class="form-group col-md-6">
                    <label for="email">Email</label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= usuario.email || '' %>" required>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label for="tipoPessoa">Tipo de pessoa</label>
                    <select class="form-control" id="tipoPessoa" name="tipoPessoa">
                        <% for (let index = 0; index < tiposPessoa.length; index++) { %>
                            <option value="<%= tiposPessoa[index] %>" <%= usuario.tipoPessoa === tiposPessoa[index] ? 'selected' : '' %>><%= tiposPessoa[index] %></option>
                        <% } %>
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <label for="perfil">Perfil</label>
                    <select class="form-control" id="perfil" name="perfil">
                        <% for (let index = 0; index < perfisUsuario.length; index++) { %>
                            <option value="<%= perfisUsuario[index] %>" <%= usuario.perfil === perfisUsuario[index] ? 'selected' : '' %>><%= perfisUsuario[index] %></option>
                        <% } %>
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <label for="ativo">Ativo</label>
                    <select class="form-control" id="ativo" name="ativo">
                        <option value="true" <%= usuario.ativo !== false ? 'selected' : '' %>>Sim</option>
                        <option value="false" <%= usuario.ativo === false ? 'selected' : '' %>>Nao</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mr-2">Salvar</button>
            <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
