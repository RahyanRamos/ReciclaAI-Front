<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ReciclaAI</title>
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon.png">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/reciclaai.css" rel="stylesheet">
</head>

<body class="h-100">
    <div class="authincation h-100">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-xl-5 col-lg-6 col-md-8">
                    <div class="authincation-content">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="text-center mb-4">
                                        <img src="/images/logo-text.png" alt="ReciclaAI" height="42">
                                    </div>
                                    <h4 class="text-center mb-4">Acesso administrativo</h4>
                                    <form>
                                        <div class="form-group">
                                            <label><strong>Usuario</strong></label>
                                            <input type="text" class="form-control" placeholder="Digite seu usuario">
                                        </div>
                                        <div class="form-group">
                                            <label><strong>Senha</strong></label>
                                            <input type="password" class="form-control" placeholder="Digite sua senha">
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-block">
                                            <i class="icon-login mr-2"></i>Entrar
                                        </button>
                                    </form>
                                    <div class="new-account mt-3 text-center">
                                        <a class="text-primary" href="/">Voltar para o painel</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/vendor/global/global.min.js"></script>
    <script src="/js/quixnav-init.js"></script>
    <script src="/js/custom.min.js"></script>
</body>

</html>
